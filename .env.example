# Environment variables for AgentML
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# Required: Groq API key — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override the default Groq model
# Default: llama3-70b-8192
GROQ_MODEL=llama3-70b-8192

# Optional: LLM temperature (0.0 = deterministic, 1.0 = creative)
# Default: 0.2  (low for reproducible narration)
GROQ_TEMPERATURE=0.2
