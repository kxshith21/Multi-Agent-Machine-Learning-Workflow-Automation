# Environment variables for AgentML
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# Required: Groq API key — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override the default Groq model
# Default: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Optional: LLM temperature (0.0 = deterministic, 1.0 = creative)
# Default: 0.2  (low for reproducible narration)
GROQ_TEMPERATURE=0.2

# Optional: Dimensionality reduction for clustering tasks only.
# Applied after impute/scale/encode, before the model zoo runs. Supervised
# tasks are never reduced.
# PREPROCESS_DIM_REDUCTION = "svd" (default) | "pca" | "off"
# PREPROCESS_DIM_REDUCTION_COMPONENTS = <int> (default min(50, n_features))
#PREPROCESS_DIM_REDUCTION=svd
#PREPROCESS_DIM_REDUCTION_COMPONENTS=50
